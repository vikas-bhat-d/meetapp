@page "/admin/room-activity"
@attribute [Authorize(Roles = "Admin")]
@layout MainLayout
@rendermode InteractiveServer
@using System.Globalization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICallLogService CallLogs
@inject NavigationManager Navigation

<PageTitle>Room activity - wincall</PageTitle>

<div class="admin-page room-log-page">
    <header class="admin-header room-log-header">
        <div>
            <span class="wc-kicker">Administrator view</span>
            <h1>Room activity</h1>
            <p>Review who joined each room, when they left, and how invitations resolved.</p>
        </div>
        <button type="button" class="btn-secondary" @onclick="() => LoadRoomsAsync()" disabled="@isLoading">@(isLoading ? "Refreshing..." : "Refresh")</button>
    </header>

    <section class="admin-card log-management-card">
        <div class="admin-card-heading">
            <div>
                <span class="wc-kicker">Data management</span>
                <h2>Export or delete logs</h2>
                <p class="admin-help">Choose a date range using the server's local time. Both dates are included.</p>
            </div>
        </div>

        <div class="log-range-fields">
            <label>
                <span class="form-label">From</span>
                <input type="date" class="form-control" @bind="logFromDate" />
            </label>
            <label>
                <span class="form-label">To</span>
                <input type="date" class="form-control" @bind="logToDate" />
            </label>
        </div>

        <div class="log-export-actions">
            <button type="button" class="btn-secondary" @onclick="ExportCallLogs" disabled="@isDeleting">Export call logs CSV</button>
            <button type="button" class="btn-secondary" @onclick="ExportRoomLogs" disabled="@isDeleting">Export room logs CSV</button>
        </div>

        <div class="log-delete-panel">
            <h3>Delete logs in this range</h3>
            <p class="admin-help">Deletion is permanent. Export the call and room CSV files first so you have a copy.</p>

            @if (deleteConfirmationNumber is int confirmationNumber)
            {
                <div class="log-confirmation-box">
                    <p>Type this six-digit number to confirm:</p>
                    <strong class="log-confirmation-code">@confirmationNumber.ToString("D6", CultureInfo.InvariantCulture)</strong>
                    <input type="text" class="form-control log-confirmation-input" @bind="deleteConfirmationInput" @bind:event="oninput" inputmode="numeric" autocomplete="off" maxlength="6" aria-label="Deletion confirmation number" />
                    <div class="log-confirmation-actions">
                        <button type="button" class="btn-secondary log-delete-button" @onclick="DeleteLogsAsync" disabled="@isDeleting">@(isDeleting ? "Deleting..." : "Delete both log types")</button>
                        <button type="button" class="btn-secondary" @onclick="CancelDeletion" disabled="@isDeleting">Cancel</button>
                    </div>
                </div>
            }
            else
            {
                <button type="button" class="btn-secondary log-delete-button" @onclick="PrepareDeletion" disabled="@isDeleting">Prepare deletion</button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(logActionError))
        {
            <div class="auth-alert auth-alert-error" role="alert">@logActionError</div>
        }
        @if (!string.IsNullOrWhiteSpace(logActionMessage))
        {
            <div class="auth-alert auth-alert-success" role="status">@logActionMessage</div>
        }
    </section>

    @if (roomPage is null)
    {
        <div class="wc-empty-state">Loading room activity...</div>
    }
    else if (roomPage!.Items.Count == 0)
    {
        <div class="wc-empty-state">
            <strong>No room activity yet</strong>
            <span>Room attendance will appear after someone joins a meeting.</span>
        </div>
    }
    else
    {
        <div class="room-log-list">
            @foreach (var room in roomPage.Items)
            {
                <article class="room-log-item">
                    <header class="room-log-item-header">
                        <div>
                            <span class="wc-kicker">Room</span>
                            <h2>@room.RoomName</h2>
                            <p>Created @FormatDateTime(room.CreatedAtUtc)</p>
                        </div>
                        <dl class="room-log-summary">
                            <div>
                                <dt>Room duration</dt>
                                <dd>@FormatRoomDuration(room)</dd>
                            </div>
                            <div>
                                <dt>People</dt>
                                <dd>@GetParticipantCount(room)</dd>
                            </div>
                            <div>
                                <dt>Invitations</dt>
                                <dd>@room.Invitations.Count</dd>
                            </div>
                        </dl>
                    </header>

                    <section class="room-log-section">
                        <h3>Participants</h3>
                        @if (room.Participants.Count == 0)
                        {
                            <p class="admin-help">No attendance session was recorded.</p>
                        }
                        else
                        {
                            <div class="user-table-wrap">
                                <table class="user-table room-log-table">
                                    <thead>
                                        <tr><th>User</th><th>Joined</th><th>Left</th><th>Duration</th><th>Status</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var participant in room.Participants)
                                        {
                                            <tr>
                                                <td><strong>@participant.DisplayName</strong><br /><span>@participant.UserName</span></td>
                                                <td>@FormatDateTime(participant.JoinedAtUtc)</td>
                                                <td>@(participant.LeftAtUtc is DateTime leftAt ? FormatDateTime(leftAt) : "Still in room")</td>
                                                <td>@FormatDuration(participant.DurationSeconds)</td>
                                                <td><span class="room-log-status @(participant.IsActive ? "room-log-status-active" : "room-log-status-ended")">@(participant.IsActive ? "Active" : "Ended")</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    <section class="room-log-section">
                        <h3>Invitations</h3>
                        @if (room.Invitations.Count == 0)
                        {
                            <p class="admin-help">No invitation was recorded for this room.</p>
                        }
                        else
                        {
                            <div class="user-table-wrap">
                                <table class="user-table room-log-table">
                                    <thead>
                                        <tr><th>From</th><th>To</th><th>Sent</th><th>Answered</th><th>Outcome</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var invitation in room.Invitations)
                                        {
                                            <tr>
                                                <td><strong>@invitation.CallerDisplayName</strong><br /><span>@invitation.CallerUserName</span></td>
                                                <td><strong>@invitation.RecipientDisplayName</strong><br /><span>@invitation.RecipientUserName</span></td>
                                                <td>@FormatDateTime(invitation.CreatedAtUtc)</td>
                                                <td>@(invitation.AnsweredAtUtc is DateTime answeredAt ? FormatDateTime(answeredAt) : "-")</td>
                                                <td><span class="room-log-status @GetInvitationStatusClass(invitation.Status)">@GetInvitationStatus(invitation.Status)</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                </article>
            }
        </div>

        @if (roomPage.TotalPages > 1)
        {
            <nav class="wc-pagination" aria-label="Room log pages">
                <button type="button" class="wc-pagination-button" @onclick="() => GoToPageAsync(currentPage - 1)" disabled="@(currentPage <= 1 || isLoading)">Previous</button>
                <span>Page @roomPage.Page of @roomPage.TotalPages</span>
                <button type="button" class="wc-pagination-button" @onclick="() => GoToPageAsync(currentPage + 1)" disabled="@(currentPage >= roomPage.TotalPages || isLoading)">Next</button>
            </nav>
        }
    }
</div>

@code {
    private const int PageSize = 15;
    private PagedResult<AdminCallRoomLogItem>? roomPage;
    private ClaimsPrincipal currentUser = new(new ClaimsIdentity());
    private int currentPage = 1;
    private bool isLoading;
    private DateTime logFromDate = DateTime.Today.AddDays(-30);
    private DateTime logToDate = DateTime.Today;
    private int? deleteConfirmationNumber;
    private string deleteConfirmationInput = string.Empty;
    private string logActionError = string.Empty;
    private string logActionMessage = string.Empty;
    private bool isDeleting;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User;
        await LoadRoomsAsync();
    }

    private async Task LoadRoomsAsync()
    {
        isLoading = true;
        try
        {
            roomPage = await CallLogs.GetAdminRoomLogsAsync(currentUser, currentPage, PageSize);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GoToPageAsync(int page)
    {
        if (roomPage is null || page < 1 || page > roomPage.TotalPages)
        {
            return;
        }

        currentPage = page;
        await LoadRoomsAsync();
    }

    private void ExportCallLogs() => ExportLogs("calls.csv");

    private void ExportRoomLogs() => ExportLogs("rooms.csv");

    private void ExportLogs(string endpoint)
    {
        if (!TryGetLogDateRange(out _, out _))
        {
            return;
        }

        logActionError = string.Empty;
        logActionMessage = string.Empty;
        var from = logFromDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        var to = logToDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        Navigation.NavigateTo($"/api/admin/logs/{endpoint}?from={from}&to={to}", forceLoad: true);
    }

    private void PrepareDeletion()
    {
        if (!TryGetLogDateRange(out _, out _))
        {
            return;
        }

        deleteConfirmationInput = string.Empty;
        deleteConfirmationNumber = System.Security.Cryptography.RandomNumberGenerator.GetInt32(100000, 1000000);
        logActionError = string.Empty;
        logActionMessage = string.Empty;
    }

    private void CancelDeletion()
    {
        deleteConfirmationNumber = null;
        deleteConfirmationInput = string.Empty;
        logActionError = string.Empty;
    }

    private async Task DeleteLogsAsync()
    {
        if (deleteConfirmationNumber is not int confirmationNumber)
        {
            return;
        }

        if (!string.Equals(deleteConfirmationInput.Trim(), confirmationNumber.ToString("D6", CultureInfo.InvariantCulture), StringComparison.Ordinal))
        {
            logActionError = "The confirmation number does not match.";
            return;
        }

        if (!TryGetLogDateRange(out var fromUtc, out var toUtcExclusive))
        {
            return;
        }

        isDeleting = true;
        logActionError = string.Empty;
        logActionMessage = string.Empty;
        try
        {
            var result = await CallLogs.DeleteAdminLogsAsync(currentUser, fromUtc, toUtcExclusive);
            deleteConfirmationNumber = null;
            deleteConfirmationInput = string.Empty;
            logActionMessage = $"Deleted {result.CallLogsDeleted} call log(s) and {result.RoomLogsDeleted} room log(s).";
            currentPage = 1;
            await LoadRoomsAsync();
        }
        finally
        {
            isDeleting = false;
        }
    }

    private bool TryGetLogDateRange(out DateTime fromUtc, out DateTime toUtcExclusive)
    {
        fromUtc = default;
        toUtcExclusive = default;
        if (logFromDate.Date > logToDate.Date)
        {
            logActionError = "The end date must be on or after the start date.";
            logActionMessage = string.Empty;
            return false;
        }

        var localFrom = DateTime.SpecifyKind(logFromDate.Date, DateTimeKind.Unspecified);
        var localToExclusive = DateTime.SpecifyKind(logToDate.Date.AddDays(1), DateTimeKind.Unspecified);
        fromUtc = TimeZoneInfo.ConvertTimeToUtc(localFrom, TimeZoneInfo.Local);
        toUtcExclusive = TimeZoneInfo.ConvertTimeToUtc(localToExclusive, TimeZoneInfo.Local);
        return true;
    }

    private static string FormatDateTime(DateTime value) => value.ToLocalTime().ToString("MMM d, yyyy h:mm:ss tt");

    private static int GetParticipantCount(AdminCallRoomLogItem room) =>
        room.Participants.Select(participant => participant.UserId).Distinct().Count();

    private static string FormatDuration(int seconds)
    {
        var duration = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return duration.TotalHours >= 1
            ? duration.ToString(@"h\h\ mm\m\ ss\s")
            : duration.ToString(@"m\m\ ss\s");
    }

    private static string FormatRoomDuration(AdminCallRoomLogItem room)
    {
        if (room.StartedAtUtc is not DateTime startedAt)
        {
            return "Not started";
        }

        var endedAt = room.EndedAtUtc ?? DateTime.UtcNow;
        return endedAt < startedAt ? "0m 00s" : FormatDuration((int)Math.Round((endedAt - startedAt).TotalSeconds));
    }

    private static string GetInvitationStatus(string status) => status switch
    {
        CallLogStatuses.Answered => "Accepted",
        CallLogStatuses.Ended => "Completed",
        CallLogStatuses.Declined => "Declined",
        CallLogStatuses.Cancelled => "Cancelled",
        CallLogStatuses.NotConnected => "Not connected",
        CallLogStatuses.NotReceived => "Not received",
        CallLogStatuses.Failed => "Failed",
        CallLogStatuses.Ringing => "Ringing",
        _ => status
    };

    private static string GetInvitationStatusClass(string status) => status switch
    {
        CallLogStatuses.Answered or CallLogStatuses.Ended => "room-log-status-active",
        CallLogStatuses.Ringing => "room-log-status-pending",
        _ => "room-log-status-ended"
    };
}
