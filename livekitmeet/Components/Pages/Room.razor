@page "/rooms/{RoomName}"
@attribute [Authorize]
@layout EmptyLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICallInvitationService CallInvitationService
@inject ICallLogService CallLogService
@implements IAsyncDisposable

<PageTitle>@(string.IsNullOrWhiteSpace(RoomName) ? "Meeting" : RoomName) - LiveKit Meet</PageTitle>

@if (needsPreJoin)
{
    <div class="lobby-container">
        <section class="lobby-card">
            <div class="lobby-brand">
                <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 5.5v13l11-6.5L7 5.5Z" /></svg></span>
                <span>LiveKit Meet</span>
            </div>
            <span class="eyebrow">Ready to join</span>
            <h1 class="lobby-title">Join @RoomName</h1>
            <p class="lobby-subtitle">You will join as <strong>@participantName</strong>.</p>

            <form class="prejoin-form" @onsubmit="StartJoin" @onsubmit:preventDefault="true">
                <div class="prejoin-options">
                    <label class="media-option">
                        <input class="media-option-input" type="checkbox" @bind="isAudioEnabled" />
                        <span class="media-option-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 14a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3Z" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8 21h8" /></svg></span>
                        <span><strong>Microphone</strong><small>@(isAudioEnabled ? "On" : "Off")</small></span>
                    </label>
                    <label class="media-option">
                        <input class="media-option-input" type="checkbox" @bind="isVideoEnabled" />
                        <span class="media-option-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h7A2.5 2.5 0 0 1 16 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 4 16.5v-9Z" /><path d="m16 10 4-2v8l-4-2" /></svg></span>
                        <span><strong>Camera</strong><small>@(isVideoEnabled ? "On" : "Off")</small></span>
                    </label>
                </div>

                <button type="submit" class="btn-primary join-submit" disabled="@string.IsNullOrWhiteSpace(participantName)">
                    <span>Enter room</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>
            </form>
        </section>
    </div>
}
else
{
    <div class="meet-container">
        <header class="meet-header">
            <div class="meet-header-left">
                <div class="room-badge">
                    <span class="room-badge-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5v-9Z" /><path d="m10 9 5 3-5 3V9Z" /></svg></span>
                    <span>@RoomName</span>
                </div>
                <span class="connection-status @GetStatusCssClass()">@connectionStatus</span>
            </div>

            <div class="meet-header-actions">
                <button type="button" class="header-btn" @onclick="() => showInviteModal = true">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    <span>Invite</span>
                </button>
                <button type="button" class="header-btn" @onclick="() => showParticipantsDrawer = !showParticipantsDrawer" aria-label="Toggle participants">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 5.5a3 3 0 0 1 0 5.8M17 14a5 5 0 0 1 3.5 5" /></svg>
                    <span>@participants.Count</span>
                </button>
            </div>
        </header>

        <!-- Video Grid Stage: JS completely controls the interior of #livekit-video-grid -->
        <main class="meet-stage">
            <div id="livekit-video-grid" class="livekit-video-grid"></div>
        </main>

        <footer class="meet-controls">
            <button type="button" class="control-btn @(!isAudioEnabled ? "active-off" : "")" @onclick="ToggleAudioAsync" title="@(isAudioEnabled ? "Mute microphone" : "Unmute microphone")" aria-label="@(isAudioEnabled ? "Mute microphone" : "Unmute microphone")">
                <span class="control-icon" aria-hidden="true">
                    @if (isAudioEnabled)
                    {
                        <svg viewBox="0 0 24 24"><path d="M12 14a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3Z" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8 21h8" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24"><path d="M12 14a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3ZM5 5l14 14" /><path d="M5 11a7 7 0 0 0 11.5 5.4M12 18v3M8 21h8" /></svg>
                    }
                </span>
                <span class="control-label">@(isAudioEnabled ? "Mute" : "Unmute")</span>
            </button>

            <button type="button" class="control-btn @(!isVideoEnabled ? "active-off" : "")" @onclick="ToggleVideoAsync" title="@(isVideoEnabled ? "Turn off camera" : "Turn on camera")" aria-label="@(isVideoEnabled ? "Turn off camera" : "Turn on camera")">
                <span class="control-icon" aria-hidden="true">
                    @if (isVideoEnabled)
                    {
                        <svg viewBox="0 0 24 24"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h7A2.5 2.5 0 0 1 16 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 4 16.5v-9Z" /><path d="m16 10 4-2v8l-4-2" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h7A2.5 2.5 0 0 1 16 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 4 16.5v-9ZM5 5l14 14" /><path d="m16 10 4-2v8l-4-2" /></svg>
                    }
                </span>
                <span class="control-label">@(isVideoEnabled ? "Stop cam" : "Start cam")</span>
            </button>

            <button type="button" class="control-btn" @onclick="() => showParticipantsDrawer = !showParticipantsDrawer" title="View participants" aria-label="View participants">
                <span class="control-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 5.5a3 3 0 0 1 0 5.8M17 14a5 5 0 0 1 3.5 5" /></svg></span>
                <span class="control-label">People (@participants.Count)</span>
            </button>

            <button type="button" class="control-btn btn-invite" @onclick="() => showInviteModal = true" title="Invite participants" aria-label="Invite participants">
                <span class="control-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1C10.7 20 4 13.3 4 5a1 1 0 0 1 1-1Z" /></svg></span>
                <span class="control-label">Invite</span>
            </button>

            <button type="button" class="control-btn btn-leave" @onclick="LeaveRoomAsync" title="Leave meeting" aria-label="Leave meeting">
                <span class="control-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M13 5H5v14h8M11 12h9M16 8l4 4-4 4" /></svg></span>
                <span class="control-label">Leave</span>
            </button>
        </footer>

        <!-- Side Drawer: Participant List (Blazor Managed) -->
        @if (showParticipantsDrawer)
        {
            <button type="button" class="drawer-backdrop" @onclick="() => showParticipantsDrawer = false" aria-label="Close participants panel"></button>
            <aside class="meet-drawer" aria-label="Participants">
                <div class="drawer-header">
                    <h3 class="drawer-title">Participants (@participants.Count)</h3>
                    <button type="button" class="drawer-close" @onclick="() => showParticipantsDrawer = false" aria-label="Close participants panel">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                    </button>
                </div>
                <div class="drawer-content">
                    <section class="drawer-invite">
                        <div class="drawer-invite-heading">
                            <span class="drawer-invite-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
                            </span>
                            <div>
                                <h4>Invite by user ID</h4>
                                <p>Type an account ID and press Enter.</p>
                            </div>
                        </div>
                        <form class="drawer-invite-form" @onsubmit="RingParticipantAsync" @onsubmit:preventDefault="true">
                            <label class="visually-hidden" for="drawerInviteUsername">User ID</label>
                            <input id="drawerInviteUsername" class="form-input" @bind="inviteUsername" @bind:event="oninput" placeholder="e.g. alex" autocomplete="off" />
                            <button type="submit" class="icon-text-button" disabled="@(string.IsNullOrWhiteSpace(inviteUsername) || isRinging)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                                <span>@(isRinging ? "Sending" : "Invite")</span>
                            </button>
                        </form>
                        @if (!string.IsNullOrEmpty(ringStatusMessage))
                        {
                            <p class="drawer-invite-status">@ringStatusMessage</p>
                        }
                    </section>

                    <div class="drawer-section-label">In this room</div>
                    @foreach (var p in participants)
                    {
                        <div class="participant-item">
                            <div class="participant-info">
                                <div class="participant-avatar-small">
                                    @(string.IsNullOrWhiteSpace(p.Name) ? "?" : p.Name.Trim().Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <span class="participant-name">@p.Name</span>
                                    @if (p.IsLocal)
                                    {
                                        <span class="participant-badge-you">(You)</span>
                                    }
                                </div>
                            </div>
                            <div>
                                <span class="participant-audio-state @(p.IsAudioEnabled ? "is-enabled" : "is-muted")" aria-label="@(p.IsAudioEnabled ? "Microphone on" : "Microphone off")">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 14a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3Z" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8 21h8" /></svg>
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </aside>
        }

        <!-- Modal: Invite & Ring Participant (Blazor Managed for Future Ringing Integration) -->
        @if (showInviteModal)
        {
            <div class="modal-backdrop" @onclick="() => showInviteModal = false">
                <div class="modal-card" @onclick:stopPropagation="true">
                    <h3 class="modal-title">Invite to Meeting</h3>
                    <p class="modal-description">
                        Share this meeting link with others to invite them:
                    </p>

                    <div class="copy-input-group">
                        <input class="copy-input" readonly value="@GetShareableMeetingUrl()" />
                        <button type="button" class="btn-primary modal-copy-button" @onclick="CopyMeetingLinkAsync">
                            @(isCopied ? "Copied!" : "Copy")
                        </button>
                    </div>

                    <hr class="modal-divider" />

                    <h4 class="modal-section-title">Invite by user ID</h4>
                    <p class="modal-description modal-description-small">Enter an account ID to send them this room invitation.</p>

                    <form class="modal-invite-form" @onsubmit="RingParticipantAsync" @onsubmit:preventDefault="true">
                        <input class="form-input" @bind="inviteUsername" @bind:event="oninput" placeholder="e.g. alex" autocomplete="off" />
                        <button type="submit" class="btn-primary btn-invite" disabled="@(string.IsNullOrWhiteSpace(inviteUsername) || isRinging)">
                            @(isRinging ? "Sending..." : "Send invite")
                        </button>
                    </form>

                    @if (!string.IsNullOrEmpty(ringStatusMessage))
                    {
                        <p class="modal-invite-status">@ringStatusMessage</p>
                    }

                    <div class="modal-actions">
                        <button class="btn-secondary" @onclick="() => showInviteModal = false">Close</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public string RoomName { get; set; } = "";

    [SupplyParameterFromQuery(Name = "audio")]
    public string? QueryAudio { get; set; }

    [SupplyParameterFromQuery(Name = "video")]
    public string? QueryVideo { get; set; }

    // Support both the documented spelling and the original URL spelling.
    [SupplyParameterFromQuery(Name = "invite")]
    public string? QueryInvite { get; set; }

    [SupplyParameterFromQuery(Name = "invide")]
    public string? QueryInvide { get; set; }

    [SupplyParameterFromQuery(Name = "invitationId")]
    public string? QueryInvitationId { get; set; }

    private string participantName = "";
    private bool needsPreJoin = false;
    private bool isAudioEnabled = true;
    private bool isVideoEnabled = true;
    private string connectionStatus = "Connecting...";
    private bool showParticipantsDrawer = false;
    private bool showInviteModal = false;
    private bool isCopied = false;
    private string inviteUsername = "";
    private bool isRinging = false;
    private string ringStatusMessage = "";
    private bool queryInvitationsSent = false;

    private List<ParticipantDto> participants = new();
    private DotNetObjectReference<Room>? dotNetRef;
    private bool hasJoined = false;
    private readonly HashSet<Guid> invitationIds = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        participantName = authState.User.FindFirst("display_name")?.Value?.Trim() ??
                          authState.User.Identity?.Name?.Trim() ??
                          string.Empty;

        if (Guid.TryParse(QueryInvitationId, out var parsedInvitationId))
        {
            invitationIds.Add(parsedInvitationId);
        }

        var hasAudioFlag = bool.TryParse(QueryAudio, out var a);
        if (hasAudioFlag)
        {
            isAudioEnabled = a;
        }
        var hasVideoFlag = bool.TryParse(QueryVideo, out var v);
        if (hasVideoFlag)
        {
            isVideoEnabled = v;
        }

        // Links that include both choices can open directly. Older/shareable
        // links without both flags still get the confirmation screen.
        needsPreJoin = !hasAudioFlag || !hasVideoFlag;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !needsPreJoin && !hasJoined)
        {
            await ConnectToRoomAsync();
            await SendQueryInvitationsAsync();
        }
    }

    private async Task StartJoin()
    {
        if (string.IsNullOrWhiteSpace(participantName))
            return;

        needsPreJoin = false;
        StateHasChanged();

        // Connect after pre-join submission
        await ConnectToRoomAsync();
        await SendQueryInvitationsAsync();
    }

    private IEnumerable<string> GetQueryInviteUserNames()
    {
        return new[] { QueryInvite, QueryInvide }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .SelectMany(value => value!.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase);
    }

    private async Task SendQueryInvitationsAsync()
    {
        if (queryInvitationsSent)
        {
            return;
        }

        var invitees = GetQueryInviteUserNames().ToArray();
        if (invitees.Length == 0)
        {
            queryInvitationsSent = true;
            return;
        }

        queryInvitationsSent = true;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var meetingUrl = GetShareableMeetingUrl();
        var results = new List<string>();

        foreach (var invitee in invitees)
        {
            var result = await CallInvitationService.SendAsync(
                authState.User,
                invitee,
                RoomName,
                meetingUrl,
                isAudioEnabled,
                isVideoEnabled);

            if (result.Success && result.InvitationId is Guid sentInvitationId)
            {
                invitationIds.Add(sentInvitationId);
            }

            results.Add(result.Success
                ? $"Invited {invitee}."
                : $"Could not invite {invitee}: {result.Error}");
        }

        ringStatusMessage = string.Join(" ", results);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConnectToRoomAsync()
    {
        if (hasJoined) return;
        hasJoined = true;

        try
        {
            connectionStatus = "Connecting...";
            StateHasChanged();

            // The protected API validates the access-token cookie and only then creates the LiveKit JWT.
            var connDetails = await JSRuntime.InvokeAsync<ConnectionDetailsDto>(
                "livekitBridge.fetchConnectionDetails",
                RoomName);

            dotNetRef = DotNetObjectReference.Create(this);

            var userChoices = new
            {
                audioEnabled = isAudioEnabled,
                videoEnabled = isVideoEnabled
            };

            // 2. Instruct JS Bridge to join room and render media streams inside #livekit-video-grid
            var joinResult = await JSRuntime.InvokeAsync<RoomJoinResult>(
                "livekitBridge.joinRoom",
                "livekit-video-grid",
                connDetails.ServerUrl,
                connDetails.ParticipantToken,
                dotNetRef,
                userChoices
            );

            if (!joinResult.Success)
            {
                connectionStatus = string.IsNullOrWhiteSpace(joinResult.Error)
                    ? "Error"
                    : $"Error: {joinResult.Error}";
                StateHasChanged();
                return;
            }

            await MarkIncomingInvitationAnsweredAsync();
        }
        catch (Exception ex)
        {
            connectionStatus = "Error";
            Console.WriteLine($"[Room] Connection error: {ex.Message}");
            StateHasChanged();
        }
    }

    public async Task ToggleAudioAsync()
    {
        try
        {
            var newState = await JSRuntime.InvokeAsync<bool>("livekitBridge.toggleAudio");
            isAudioEnabled = newState;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Room] Error toggling audio: {ex.Message}");
        }
    }

    public async Task ToggleVideoAsync()
    {
        try
        {
            var newState = await JSRuntime.InvokeAsync<bool>("livekitBridge.toggleVideo");
            isVideoEnabled = newState;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Room] Error toggling video: {ex.Message}");
        }
    }

    public async Task LeaveRoomAsync()
    {
        participantLeaveRequested = true;
        try
        {
            await JSRuntime.InvokeVoidAsync("livekitBridge.leaveRoom");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Room] Error leaving room: {ex.Message}");
        }
        finally
        {
            await FinalizeParticipantSessionAsync();
            await FinalizeCallLogsAsync();
            Navigation.NavigateTo("/");
        }
    }

    private async Task CopyMeetingLinkAsync()
    {
        var url = GetShareableMeetingUrl();
        var ok = await JSRuntime.InvokeAsync<bool>("livekitBridge.copyToClipboard", url);
        if (ok)
        {
            isCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            isCopied = false;
            StateHasChanged();
        }
    }

    private async Task RingParticipantAsync()
    {
        var invitee = inviteUsername.Trim();
        if (string.IsNullOrWhiteSpace(invitee)) return;

        isRinging = true;
        ringStatusMessage = $"Sending an invitation to {invitee}...";
        StateHasChanged();

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var result = await CallInvitationService.SendAsync(
                authState.User,
                invitee,
                RoomName,
                GetShareableMeetingUrl(),
                isAudioEnabled,
                isVideoEnabled);

            if (result.Success && result.InvitationId is Guid sentInvitationId)
            {
                invitationIds.Add(sentInvitationId);
            }

            ringStatusMessage = result.Success
                ? $"Invitation sent to '{invitee}'."
                : result.Error ?? "The invitation could not be sent.";
            if (result.Success)
            {
                inviteUsername = string.Empty;
            }
        }
        catch (Exception ex)
        {
            ringStatusMessage = ex.Message;
        }
        finally
        {
            isRinging = false;
            StateHasChanged();
        }
    }

    private string GetShareableMeetingUrl()
    {
        var baseUri = Navigation.BaseUri.TrimEnd('/');
        return $"{baseUri}/rooms/{Uri.EscapeDataString(RoomName)}?audio={isAudioEnabled.ToString().ToLowerInvariant()}&video={isVideoEnabled.ToString().ToLowerInvariant()}";
    }

    private string GetStatusCssClass() => connectionStatus switch
    {
        "Connected" => "status-connected",
        "Connecting..." => "status-connecting",
        _ => "status-disconnected"
    };

    [JSInvokable]
    public async Task OnRoomConnected(string roomName, string identity)
    {
        connectionStatus = "Connected";
        await StartParticipantSessionAsync(roomName);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnConnectionStatusChanged(string status)
    {
        connectionStatus = status;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnConnectionError(string message)
    {
        connectionStatus = "Error: " + message;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnMediaError(string mediaType, string message)
    {
        if (string.Equals(mediaType, "microphone", StringComparison.OrdinalIgnoreCase))
        {
            connectionStatus = "Microphone unavailable";
        }

        Console.WriteLine($"[Room] {mediaType} error: {message}");
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnDisconnected()
    {
        connectionStatus = "Disconnected";
        participantLeaveRequested = true;
        await FinalizeParticipantSessionAsync();
        await FinalizeCallLogsAsync();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnParticipantsUpdated(List<ParticipantDto> updatedList)
    {
        participants = updatedList ?? new();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnTrackStateChanged(bool audio, bool video)
    {
        isAudioEnabled = audio;
        isVideoEnabled = video;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        participantLeaveRequested = true;
        await FinalizeParticipantSessionAsync();
        await FinalizeCallLogsAsync();

        try
        {
            await JSRuntime.InvokeVoidAsync("livekitBridge.leaveRoom");
        }
        catch
        {
            // Ignore during page unload
        }
        dotNetRef?.Dispose();
    }

    private Guid? participantSessionId;
    private bool participantLeaveRequested;
    private Task? participantFinalizationTask;
    private bool callLogsFinalized;

    private async Task StartParticipantSessionAsync(string roomName)
    {
        if (participantSessionId is not null)
        {
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        Guid? invitationId = Guid.TryParse(QueryInvitationId, out var parsedInvitationId)
            ? parsedInvitationId
            : null;
        participantSessionId = await CallLogService.JoinParticipantAsync(
            authState.User,
            roomName,
            GetShareableMeetingUrl(),
            invitationId);

        if (participantLeaveRequested)
        {
            await FinalizeParticipantSessionAsync();
        }
    }

    private async Task FinalizeParticipantSessionAsync()
    {
        if (participantSessionId is not Guid sessionId)
        {
            return;
        }

        participantFinalizationTask ??= FinalizeParticipantSessionCoreAsync(sessionId);
        await participantFinalizationTask;
    }

    private async Task FinalizeParticipantSessionCoreAsync(Guid sessionId)
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            await CallLogService.LeaveParticipantAsync(authState.User, sessionId);
        }
        catch
        {
            // Ignore during page unload.
        }
    }

    private async Task MarkIncomingInvitationAnsweredAsync()
    {
        if (!Guid.TryParse(QueryInvitationId, out var invitationId))
        {
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        await CallLogService.MarkAnsweredAsync(authState.User, invitationId);
    }

    private async Task FinalizeCallLogsAsync()
    {
        if (callLogsFinalized || invitationIds.Count == 0)
        {
            return;
        }

        callLogsFinalized = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            foreach (var invitationId in invitationIds)
            {
                var ended = await CallLogService.MarkEndedAsync(authState.User, invitationId);
                if (!ended)
                {
                    await CallInvitationService.CancelAsync(authState.User, invitationId);
                }
            }
        }
        catch
        {
            // Ignore during page unload.
