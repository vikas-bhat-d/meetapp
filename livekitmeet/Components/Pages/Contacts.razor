@page "/contacts"
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@layout MainLayout
@rendermode InteractiveServer
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ICallInvitationService CallInvitationService
@inject IUserPresenceService UserPresence

<PageTitle>wincall - Contacts</PageTitle>

<div class="wc-page wc-contacts-page">
    <header class="wc-page-heading">
        <div>
            <span class="wc-kicker">Directory</span>
            <h1>Contacts</h1>
            <p>Find someone from your workspace and start a call.</p>
        </div>
        <span class="wc-page-count">@(contactsPage?.TotalCount ?? 0) people</span>
    </header>

    <div class="wc-search-bar">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
        <input class="wc-input" value="@searchTerm" @oninput="HandleSearchInput" placeholder="Search users..." autocomplete="off" />
        @if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <button type="button" class="wc-clear-button" @onclick="ClearSearchAsync" aria-label="Clear search" title="Clear search">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(callStatusMessage))
    {
        <p class="wc-call-status" role="status">@callStatusMessage</p>
    }

    @if (contactsPage is null)
    {
        <div class="wc-empty-state">Loading contacts...</div>
    }
    else if (contactsPage.Items.Count == 0)
    {
        <div class="wc-empty-state">
            <span class="wc-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg></span>
            <strong>No contacts found</strong>
            <span>Try a different name or username.</span>
        </div>
    }
    else
    {
        <div class="wc-contact-grid">
            @foreach (var user in contactsPage.Items)
            {
                <article class="wc-contact-card">
                    <div class="wc-contact-card-person">
                        <span class="wc-contact-avatar wc-contact-avatar-large">@GetInitials(user.DisplayName)</span>
                        <div>
                            <h2>@user.DisplayName</h2>
                            <p>@@@user.UserName</p>
                        </div>
                    </div>
                    <div class="wc-contact-card-footer">
                        <span class="wc-online-dot @GetStatusCssClass(GetContactStatus(user.Id))">@GetContactStatus(user.Id)</span>
                        <button type="button" class="wc-primary-icon-button" @onclick="() => CallContactAsync(user.UserName)" disabled="@isStartingCall" aria-label="Call @user.DisplayName" title="Call @user.DisplayName">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h3l2 5-2.3 1.4a12.7 12.7 0 0 0 4.9 4.9L15 13l5 2v3a1 1 0 0 1-1 1C10.7 19 5 13.3 5 6a2 2 0 0 1 1-2Z" /></svg>
                            <span>Call</span>
                        </button>
                    </div>
                </article>
            }
        </div>

        @if (contactsPage.TotalPages > 1)
        {
            <nav class="wc-pagination" aria-label="Contact pages">
                <button type="button" class="wc-pagination-button" @onclick="() => GoToPageAsync(currentPage - 1)" disabled="@(currentPage <= 1 || isLoading)">Previous</button>
                <span>Page @contactsPage.Page of @contactsPage.TotalPages</span>
                <button type="button" class="wc-pagination-button" @onclick="() => GoToPageAsync(currentPage + 1)" disabled="@(currentPage >= contactsPage.TotalPages || isLoading)">Next</button>
            </nav>
        }
    }
</div>

@code {
    private const int PageSize = 20;
    private PagedResult<AppUser>? contactsPage;
    private ClaimsPrincipal currentUser = new(new ClaimsIdentity());
    private Guid currentUserId;
    private IReadOnlyDictionary<Guid, UserPresenceSnapshot> contactPresence = new Dictionary<Guid, UserPresenceSnapshot>();
    private string searchTerm = string.Empty;
    private string callStatusMessage = string.Empty;
    private bool isStartingCall;
    private int currentPage = 1;
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User;
        Guid.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out currentUserId);
        await LoadContactsAsync();
    }

    private async Task HandleSearchInput(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        await LoadContactsAsync();
    }

    private async Task ClearSearchAsync()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        await LoadContactsAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        if (contactsPage is null || page < 1 || page > contactsPage.TotalPages)
        {
            return;
        }

        currentPage = page;
        await LoadContactsAsync();
    }

    private async Task LoadContactsAsync()
    {
        isLoading = true;
        try
        {
            var query = Db.Users
                .AsNoTracking()
                .Where(user => user.IsActive && user.Id != currentUserId);

            var trimmedSearchTerm = searchTerm.Trim();
            if (trimmedSearchTerm.Length > 0)
            {
                query = query.Where(user => user.DisplayName.Contains(trimmedSearchTerm) || user.UserName.Contains(trimmedSearchTerm));
            }

            var totalCount = await query.CountAsync();
            var totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));
            currentPage = Math.Min(currentPage, totalPages);

            var items = await query
                .OrderBy(user => user.DisplayName)
                .Skip((currentPage - 1) * PageSize)
                .Take(PageSize)
                .ToListAsync();

            contactsPage = new PagedResult<AppUser>(items, currentPage, PageSize, totalCount);
            contactPresence = await UserPresence.GetManyAsync(items.Select(user => user.Id));
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetContactStatus(Guid userId) => contactPresence.TryGetValue(userId, out var presence)
        ? presence.Status
        : UserPresenceStatuses.Unavailable;

    private static string GetStatusCssClass(string status) => status switch
    {
        UserPresenceStatuses.InCall => "status-in-call",
        UserPresenceStatuses.DoNotDisturb => "status-dnd",
        UserPresenceStatuses.Reachable => "status-reachable",
        _ => "status-unreachable"
    };

    private async Task CallContactAsync(string username)
    {
        if (isStartingCall)
        {
            return;
        }

        isStartingCall = true;
        callStatusMessage = string.Empty;
        try
        {
            var availability = await CallInvitationService.CheckAvailabilityAsync(currentUser, username);
            if (!availability.Available)
            {
                callStatusMessage = availability.Error ?? "That user is not currently available.";
                return;
            }
        }
        finally
        {
            isStartingCall = false;
        }

        var roomName = $"call-{Guid.NewGuid():N}"[..15];
        Navigation.NavigateTo($"/rooms/{Uri.EscapeDataString(roomName)}?audio=true&video=false&invite={Uri.EscapeDataString(username)}");
    }

    private static string GetInitials(string value)
    {
        var words = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length switch
        {
            0 => "?",
            1 => words[0][..1].ToUpperInvariant(),
            _ => string.Concat(words[0][..1], words[^1][..1]).ToUpperInvariant()
        };
    }
}