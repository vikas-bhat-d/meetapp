@page "/"
@attribute [Authorize]
@layout MainLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICallLogService CallLogs
@inject ICallInvitationService CallInvitationService
@inject IUserPresenceService UserPresence

<PageTitle>wincall - Home</PageTitle>

<div class="wc-page wc-home">
    <header class="wc-page-heading">
        <div>
            <h1>Welcome back, @firstName</h1>
            <p>Pick up where you left off or start a new conversation.</p>
        </div>
        <div class="wc-status-dropdown @(isStatusMenuOpen ? "is-open" : string.Empty)">
            <button type="button" class="wc-user-chip wc-status-summary" @onclick="ToggleStatusMenu" aria-expanded="@isStatusMenuOpen" aria-controls="status-menu">
                <span class="wc-avatar">@GetInitials(displayName)</span>
                <span class="wc-user-chip-copy">
                    <strong>@displayName</strong>
                    <small><span class="wc-status-dot @GetStatusCssClass(currentPresence?.Status)"></span>@GetCurrentStatusLabel()</small>
                </span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5" /></svg>
            </button>
            @if (isStatusMenuOpen)
            {
                <button type="button" class="wc-status-dismiss-layer" @onclick="CloseStatusMenu" aria-label="Close invitation status menu"></button>
                <div id="status-menu" class="wc-status-menu">
                    <span class="wc-status-menu-label">Invitation status</span>
                    <button type="button" class="wc-status-option @(GetPresenceOptionClass(false))" @onclick="() => SetDoNotDisturbAsync(false)" aria-pressed="@(!IsDoNotDisturb)">
                        <span class="wc-status-dot status-reachable"></span>
                        <span><strong>Reachable</strong><small>Receive invitations</small></span>
                        @if (!IsDoNotDisturb)
                        {
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                        }
                    </button>
                    <button type="button" class="wc-status-option @(GetPresenceOptionClass(true))" @onclick="() => SetDoNotDisturbAsync(true)" aria-pressed="@IsDoNotDisturb">
                        <span class="wc-status-dot status-dnd"></span>
                        <span><strong>Do Not Disturb</strong><small>Block invitations</small></span>
                        @if (IsDoNotDisturb)
                        {
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                        }
                    </button>
                    <a class="wc-status-profile-link" href="/profile">My profile <span aria-hidden="true">&rarr;</span></a>
                    @if (!string.IsNullOrWhiteSpace(presenceStatusMessage))
                    {
                        <p class="wc-status-menu-message" role="status">@presenceStatusMessage</p>
                    }
                </div>
            }
        </div>
    </header>

    <div class="wc-dashboard-grid">
        <section class="wc-panel wc-call-panel">
            <div class="wc-panel-heading">
                <span class="wc-panel-icon wc-panel-icon-red" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M6 4h3l2 5-2.3 1.4a12.7 12.7 0 0 0 4.9 4.9L15 13l5 2v3a1 1 0 0 1-1 1C10.7 19 5 13.3 5 6a2 2 0 0 1 1-2Z" /></svg>
                </span>
                <div>
                    <span class="wc-panel-label">Quick call</span>
                    <h2>Who would you like to call?</h2>
                    <p>Search by username and we will open a private room.</p>
                </div>
            </div>

            <form class="wc-call-form" @onsubmit="StartCall" @onsubmit:preventDefault="true">
                <label class="wc-field-label" for="callUsername">Username</label>
                <div class="wc-call-input-wrap">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
                    <input id="callUsername" class="wc-input" @bind="targetUsername" @bind:event="oninput" placeholder="e.g. ananya" autocomplete="off" />
                    <button type="submit" class="wc-call-button" disabled="@(string.IsNullOrWhiteSpace(targetUsername) || isStartingCall)" aria-label="Call user" title="Call user">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h3l2 5-2.3 1.4a12.7 12.7 0 0 0 4.9 4.9L15 13l5 2v3a1 1 0 0 1-1 1C10.7 19 5 13.3 5 6a2 2 0 0 1 1-2Z" /></svg>
                    </button>
                </div>
                <a class="wc-text-link" href="/contacts">Browse all contacts <span aria-hidden="true">&rarr;</span></a>
                @if (!string.IsNullOrWhiteSpace(callStatusMessage))
                {
                    <p class="wc-call-status" role="status">@callStatusMessage</p>
                }
            </form>
        </section>

    </div>

    <section class="wc-recent-section">
        <header class="wc-section-heading">
            <div>
                <span class="wc-kicker">Your activity</span>
                <h2>Recent calls</h2>
            </div>
            <a class="wc-text-link" href="/calls">View all <span aria-hidden="true">&rarr;</span></a>
        </header>

        @if (recentCalls is null)
        {
            <div class="wc-empty-state">Loading your recent calls...</div>
        }
        else if (recentCalls.Count == 0)
        {
            <div class="wc-empty-state">
                <span class="wc-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 4h3l2 5-2.3 1.4a12.7 12.7 0 0 0 4.9 4.9L15 13l5 2v3a1 1 0 0 1-1 1C10.7 19 5 13.3 5 6a2 2 0 0 1 1-2Z" /></svg></span>
                <strong>No calls yet</strong>
                <span>Your conversations will appear here.</span>
            </div>
        }
        else
        {
            <div class="wc-call-list">
                @foreach (var call in recentCalls.Take(5))
                {
                    <div class="wc-call-row">
                        <div class="wc-call-person">
                            <span class="wc-contact-avatar">@GetInitials(GetContactName(call))</span>
                            <span class="wc-call-person-copy">
                                <strong>@GetContactName(call)</strong>
                                <small>@(call.IsIncoming ? "Incoming" : "Outgoing") · @GetCallStatus(call)</small>
                            </span>
                        </div>
                        <div class="wc-call-meta">
                            <span>@GetCallDetail(call)</span>
                            <small>@GetTimeLabel(call.CreatedAtUtc)</small>
                        </div>
                        <button type="button" class="wc-row-call" @onclick="() => OpenRoom(call.RoomName)" aria-label="Open @call.RoomName" title="Open @call.RoomName">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h3l2 5-2.3 1.4a12.7 12.7 0 0 0 4.9 4.9L15 13l5 2v3a1 1 0 0 1-1 1C10.7 19 5 13.3 5 6a2 2 0 0 1 1-2Z" /></svg>
                        </button>
                    </div>
                }
            </div>
        }
    </section>
</div>

@code {
    private IReadOnlyList<CallLogItem>? recentCalls;
    private string displayName = "there";
    private string firstName = "there";
    private string targetUsername = string.Empty;
    private string callStatusMessage = string.Empty;
    private string presenceStatusMessage = string.Empty;
    private ClaimsPrincipal currentUser = new(new ClaimsIdentity());
    private UserPresenceSnapshot? currentPresence;
    private bool isUpdatingPresence;
    private bool isStartingCall;
    private bool isStatusMenuOpen;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User;
        displayName = authState.User.FindFirst("display_name")?.Value?.Trim() ??
                      authState.User.Identity?.Name?.Trim() ??
                      "there";
        firstName = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? displayName;
        if (Guid.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUserId))
        {
            currentPresence = await UserPresence.GetAsync(currentUserId);
        }

        recentCalls = (await CallLogs.GetRecentAsync(authState.User, 1, 10)).Items;
    }

    private bool IsDoNotDisturb => currentPresence?.IsDoNotDisturb == true;

    private string GetCurrentStatusLabel() => currentPresence?.Status ?? UserPresenceStatuses.Unavailable;

    private string GetPresenceOptionClass(bool dnd) =>
        IsDoNotDisturb == dnd ? "is-selected" : string.Empty;

    private void ToggleStatusMenu() => isStatusMenuOpen = !isStatusMenuOpen;

    private void CloseStatusMenu() => isStatusMenuOpen = false;

    private static string GetStatusCssClass(string? status) => status switch
    {
        UserPresenceStatuses.InCall => "status-in-call",
        UserPresenceStatuses.DoNotDisturb => "status-dnd",
        UserPresenceStatuses.Reachable => "status-reachable",
        _ => "status-unreachable"
    };

    private async Task SetDoNotDisturbAsync(bool enabled)
    {
        isStatusMenuOpen = false;
        if (isUpdatingPresence || IsDoNotDisturb == enabled)
        {
            return;
        }

        isUpdatingPresence = true;
        presenceStatusMessage = string.Empty;
        try
        {
            if (!await UserPresence.SetDoNotDisturbAsync(currentUser, enabled))
            {
                presenceStatusMessage = "Your invitation status could not be updated.";
                return;
            }

            if (Guid.TryParse(currentUser.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUserId))
            {
                currentPresence = await UserPresence.GetAsync(currentUserId);
            }
        }
        catch (Exception ex)
        {
            presenceStatusMessage = ex.Message;
        }
        finally
        {
            isUpdatingPresence = false;
        }
    }

    private async Task StartCall()
    {
        await CallContactAsync(targetUsername);
    }

    private async Task CallContactAsync(string username)
    {
        if (string.IsNullOrWhiteSpace(username))
        {
            return;
        }

        isStartingCall = true;
        callStatusMessage = string.Empty;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var availability = await CallInvitationService.CheckAvailabilityAsync(authState.User, username.Trim());
            if (!availability.Available)
            {
                callStatusMessage = availability.Error ?? "That user is not currently available.";
                return;
            }
        }
        finally
        {
            isStartingCall = false;
        }

        var roomName = $"call-{Guid.NewGuid():N}"[..15];
        Navigation.NavigateTo($"/rooms/{Uri.EscapeDataString(roomName)}?audio=true&video=false&invite={Uri.EscapeDataString(username.Trim())}");
    }

    private static string GetInitials(string value)
    {
        var words = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length switch
        {
            0 => "?",
            1 => words[0][..1].ToUpperInvariant(),
            _ => string.Concat(words[0][..1], words[^1][..1]).ToUpperInvariant()
        };
    }

    private void OpenRoom(string roomName)
    {
        Navigation.NavigateTo($"/rooms/{Uri.EscapeDataString(roomName)}?audio=true&video=false");
    }

    private static string GetContactName(CallLogItem call) =>
        string.IsNullOrWhiteSpace(call.ContactDisplayName) ? call.ContactUserName : call.ContactDisplayName;

    private static string GetCallStatus(CallLogItem call) => GetInvitationStatusLabel(call.Status);

    private static string GetCallDetail(CallLogItem call) => call.DurationSeconds is int durationSeconds
        ? FormatDuration(TimeSpan.FromSeconds(durationSeconds))
        : GetCallStatus(call);

    private static string GetInvitationStatusLabel(string status) => status switch
    {
        CallLogStatuses.Declined => "Declined",
        CallLogStatuses.Cancelled => "Cancelled",
        CallLogStatuses.NotConnected => "Not connected",
        CallLogStatuses.NotReceived => "Not received",
        CallLogStatuses.Failed => "Delivery failed",
        CallLogStatuses.Ringing => "Calling",
        CallLogStatuses.Answered => "Accepted",
        CallLogStatuses.Ended => "Completed",
        _ => status
    };

    private static string FormatDuration(TimeSpan duration) => duration.TotalHours >= 1
        ? duration.ToString(@"h\h\ mm\m")
        : duration.ToString(@"m\m\ ss\s");

    private static string GetTimeLabel(DateTime createdAtUtc)
    {
        var createdAt = createdAtUtc.ToLocalTime();
        var today = DateTime.Now.Date;
        return createdAt.Date == today
            ? createdAt.ToString("h:mm tt")
            : createdAt.Date == today.AddDays(-1)
                ? "Yesterday"
                : createdAt.ToString("MMM d");
    }
}
