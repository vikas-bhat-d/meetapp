@page "/"
@attribute [Authorize]
@layout MainLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICallLogService CallLogs

<PageTitle>wincall - Home</PageTitle>

<div class="wc-page wc-home">
    <header class="wc-page-heading">
        <div>
            <span class="wc-kicker">Workspace</span>
            <h1>Welcome back, @firstName</h1>
            <p>Pick up where you left off or start a new conversation.</p>
        </div>
        <a class="wc-user-chip" href="/profile">
            <span class="wc-avatar">@GetInitials(displayName)</span>
            <span class="wc-user-chip-copy">
                <strong>@displayName</strong>
                <small>My profile</small>
            </span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
        </a>
    </header>

    <div class="wc-dashboard-grid">
        <section class="wc-panel wc-call-panel">
            <div class="wc-panel-heading">
                <span class="wc-panel-icon wc-panel-icon-red" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M6 4h3l2 5-2.3 1.4a12.7 12.7 0 0 0 4.9 4.9L15 13l5 2v3a1 1 0 0 1-1 1C10.7 19 5 13.3 5 6a2 2 0 0 1 1-2Z" /></svg>
                </span>
                <div>
                    <span class="wc-panel-label">Quick call</span>
                    <h2>Who would you like to call?</h2>
                    <p>Search by username and we will open a private room.</p>
                </div>
            </div>

            <form class="wc-call-form" @onsubmit="StartCall" @onsubmit:preventDefault="true">
                <label class="wc-field-label" for="callUsername">Username</label>
                <div class="wc-call-input-wrap">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
                    <input id="callUsername" class="wc-input" @bind="targetUsername" @bind:event="oninput" placeholder="e.g. ananya" autocomplete="off" />
                    <button type="submit" class="wc-call-button" disabled="@string.IsNullOrWhiteSpace(targetUsername)" aria-label="Call user" title="Call user">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h3l2 5-2.3 1.4a12.7 12.7 0 0 0 4.9 4.9L15 13l5 2v3a1 1 0 0 1-1 1C10.7 19 5 13.3 5 6a2 2 0 0 1 1-2Z" /></svg>
                    </button>
                </div>
                <a class="wc-text-link" href="/contacts">Browse all contacts <span aria-hidden="true">&rarr;</span></a>
            </form>
        </section>

        <section class="wc-panel wc-status-panel">
            <div class="wc-status-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 9 9" /><path d="M12 7v5l3 2" /><path d="m16 4 2-1 1 2" /></svg>
            </div>
            <div>
                <span class="wc-panel-label">Your space</span>
                <h2>Ready when you are</h2>
                <p>Every room is kept in your history, including invitation outcomes.</p>
            </div>
            <a class="wc-secondary-button" href="/calls">View call history</a>
        </section>
    </div>

    <section class="wc-recent-section">
        <header class="wc-section-heading">
            <div>
                <span class="wc-kicker">Your activity</span>
                <h2>Recent calls</h2>
            </div>
            <a class="wc-text-link" href="/calls">View all <span aria-hidden="true">&rarr;</span></a>
        </header>

        @if (recentRooms is null)
        {
            <div class="wc-empty-state">Loading your recent calls...</div>
        }
        else if (recentRooms.Count == 0)
        {
            <div class="wc-empty-state">
                <span class="wc-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 4h3l2 5-2.3 1.4a12.7 12.7 0 0 0 4.9 4.9L15 13l5 2v3a1 1 0 0 1-1 1C10.7 19 5 13.3 5 6a2 2 0 0 1 1-2Z" /></svg></span>
                <strong>No calls yet</strong>
                <span>Your conversations will appear here.</span>
            </div>
        }
        else
        {
            <div class="wc-call-list">
                @foreach (var room in recentRooms.Take(5))
                {
                    <div class="wc-call-row">
                        <div class="wc-call-person">
                            <span class="wc-contact-avatar">RM</span>
                            <span class="wc-call-person-copy">
                                <strong>@room.RoomName</strong>
                                <small>@GetParticipantNames(room) · @GetRoomStatus(room)</small>
                            </span>
                        </div>
                        <div class="wc-call-meta">
                            <span>@GetRoomDetail(room)</span>
                            <small>@GetTimeLabel(room.CreatedAtUtc)</small>
                        </div>
                        <button type="button" class="wc-row-call" @onclick="() => OpenRoom(room.RoomName)" aria-label="Open @room.RoomName" title="Open @room.RoomName">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h3l2 5-2.3 1.4a12.7 12.7 0 0 0 4.9 4.9L15 13l5 2v3a1 1 0 0 1-1 1C10.7 19 5 13.3 5 6a2 2 0 0 1 1-2Z" /></svg>
                        </button>
                    </div>
                }
            </div>
        }
    </section>
</div>

@code {
    private IReadOnlyList<CallRoomHistoryItem>? recentRooms;
    private string displayName = "there";
    private string firstName = "there";
    private string targetUsername = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        displayName = authState.User.FindFirst("display_name")?.Value?.Trim() ??
                      authState.User.Identity?.Name?.Trim() ??
                      "there";
        firstName = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? displayName;
        recentRooms = await CallLogs.GetRecentRoomLogsAsync(authState.User, 10);
    }

    private void StartCall()
    {
        CallContact(targetUsername);
    }

    private void CallContact(string username)
    {
        if (string.IsNullOrWhiteSpace(username))
        {
            return;
        }

        var roomName = $"call-{Guid.NewGuid():N}"[..15];
        Navigation.NavigateTo($"/rooms/{Uri.EscapeDataString(roomName)}?audio=true&video=true&invite={Uri.EscapeDataString(username.Trim())}");
    }

    private static string GetInitials(string value)
    {
        var words = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length switch
        {
            0 => "?",
            1 => words[0][..1].ToUpperInvariant(),
            _ => string.Concat(words[0][..1], words[^1][..1]).ToUpperInvariant()
        };
    }

    private void OpenRoom(string roomName)
    {
        Navigation.NavigateTo($"/rooms/{Uri.EscapeDataString(roomName)}?audio=true&video=true");
    }

    private static string GetRoomStatus(CallRoomHistoryItem room) => room.Status;

    private static string GetRoomDetail(CallRoomHistoryItem room)
    {
        return room.DurationSeconds is int durationSeconds
            ? FormatDuration(TimeSpan.FromSeconds(durationSeconds))
            : room.Status;
    }

    private static string GetParticipantNames(CallRoomHistoryItem room)
    {
        var names = room.Participants
            .Select(participant => participant.DisplayName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        return names.Length == 0 ? "No one joined" : string.Join(", ", names);
    }

    private static string GetInvitationStatusLabel(string status) => status switch
    {
        CallLogStatuses.Declined => "Declined",
        CallLogStatuses.Cancelled => "Cancelled",
        CallLogStatuses.Failed => "Not connected",
        CallLogStatuses.Ringing => "Calling",
        CallLogStatuses.Answered or CallLogStatuses.Ended => "Completed",
        _ => status
    };

    private static string FormatDuration(TimeSpan duration) => duration.TotalHours >= 1
        ? duration.ToString(@"h\h\ mm\m")
        : duration.ToString(@"m\m\ ss\s");

    private static string GetTimeLabel(DateTime createdAtUtc)
    {
        var createdAt = createdAtUtc.ToLocalTime();
        var today = DateTime.Now.Date;
        return createdAt.Date == today
            ? createdAt.ToString("h:mm tt")
            : createdAt.Date == today.AddDays(-1)
                ? "Yesterday"
                : createdAt.ToString("MMM d");
    }
}
