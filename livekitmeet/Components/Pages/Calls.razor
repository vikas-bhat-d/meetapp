@page "/calls"
@attribute [Authorize]
@layout MainLayout
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICallLogService CallLogs
@inject NavigationManager Navigation

<PageTitle>wincall - Call history</PageTitle>

<div class="wc-page wc-calls-page">
    <header class="wc-page-heading">
        <div>
            <span class="wc-kicker">Your activity</span>
            <h1>Call history</h1>
            <p>Every invitation, participant session, and call outcome in one place.</p>
        </div>
        <a class="wc-primary-button" href="/contacts">Start a call <span aria-hidden="true">+</span></a>
    </header>

    <div class="wc-search-bar">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
        <input class="wc-input" value="@searchTerm" @oninput="HandleSearchInput" placeholder="Search call history..." autocomplete="off" />
    </div>

    @if (callPage is null)
    {
        <div class="wc-empty-state">Loading call history...</div>
    }
    else if (callPage.Items.Count == 0)
    {
        <div class="wc-empty-state">
            <span class="wc-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 4h3l2 5-2.3 1.4a12.7 12.7 0 0 0 4.9 4.9L15 13l5 2v3a1 1 0 0 1-1 1C10.7 19 5 13.3 5 6a2 2 0 0 1 1-2Z" /></svg></span>
            <strong>No matching calls</strong>
            <span>Start a call from your contacts to build your history.</span>
        </div>
    }
    else
    {
        <section class="wc-history-list" aria-label="Call history">
            @foreach (var call in callPage.Items)
            {
                <div class="wc-history-row wc-room-history-row">
                    <div class="wc-call-person">
                        <span class="wc-contact-avatar">@GetInitials(GetContactName(call))</span>
                        <span class="wc-call-person-copy">
                            <strong>@GetContactName(call)</strong>
                            <small>@(call.IsIncoming ? "Incoming" : "Outgoing") · @call.RoomName</small>
                        </span>
                    </div>
                    <div class="wc-history-room">
                        <span>@call.RoomName</span>
                        <small>@GetTimeLabel(call.CreatedAtUtc)</small>
                    </div>
                    <div class="wc-history-result @GetCallStatusClass(call.Status)">
                        <span>@GetCallDetail(call)</span>
                        <small>@GetCallStatus(call)</small>
                    </div>
                    <button type="button" class="wc-row-call" @onclick="() => OpenRoom(call.RoomName)" aria-label="Open @call.RoomName" title="Open @call.RoomName">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </button>
                </div>
            }
        </section>

        @if (callPage.TotalPages > 1)
        {
            <nav class="wc-pagination" aria-label="Call history pages">
                <button type="button" class="wc-pagination-button" @onclick="() => GoToPageAsync(currentPage - 1)" disabled="@(currentPage <= 1 || isLoading)">Previous</button>
                <span>Page @callPage.Page of @callPage.TotalPages</span>
                <button type="button" class="wc-pagination-button" @onclick="() => GoToPageAsync(currentPage + 1)" disabled="@(currentPage >= callPage.TotalPages || isLoading)">Next</button>
            </nav>
        }
    }
</div>

@code {
    private const int PageSize = 20;
    private PagedResult<CallLogItem>? callPage;
    private ClaimsPrincipal currentUser = new(new ClaimsIdentity());
    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User;
        await LoadCallsAsync();
    }

    private async Task HandleSearchInput(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        await LoadCallsAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        if (callPage is null || page < 1 || page > callPage.TotalPages)
        {
            return;
        }

        currentPage = page;
        await LoadCallsAsync();
    }

    private async Task LoadCallsAsync()
    {
        isLoading = true;
        try
        {
            callPage = await CallLogs.GetRecentAsync(currentUser, currentPage, PageSize, searchTerm);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenRoom(string roomName)
    {
        Navigation.NavigateTo($"/rooms/{Uri.EscapeDataString(roomName)}?audio=true&video=false");
    }

    private static string GetContactName(CallLogItem call) =>
        string.IsNullOrWhiteSpace(call.ContactDisplayName) ? call.ContactUserName : call.ContactDisplayName;

    private static string GetCallStatus(CallLogItem call) => GetInvitationStatusLabel(call.Status);

    private static string GetCallStatusClass(string status) => status switch
    {
        CallLogStatuses.Declined => "declined",
        CallLogStatuses.Cancelled => "cancelled",
        CallLogStatuses.NotConnected => "not-connected",
        CallLogStatuses.NotReceived => "not-received",
        CallLogStatuses.Failed => "failed",
        CallLogStatuses.Answered => "answered",
        CallLogStatuses.Ended => "completed",
        CallLogStatuses.Ringing => "calling",
        _ => "ended"
    };

    private static string GetCallDetail(CallLogItem call) => call.DurationSeconds is int durationSeconds
        ? FormatDuration(TimeSpan.FromSeconds(durationSeconds))
        : GetCallStatus(call);

    private static string GetInvitationStatusLabel(string status) => status switch
    {
        CallLogStatuses.Declined => "Declined",
        CallLogStatuses.Cancelled => "Cancelled",
        CallLogStatuses.NotConnected => "Not connected",
        CallLogStatuses.NotReceived => "Not received",
        CallLogStatuses.Failed => "Delivery failed",
        CallLogStatuses.Ringing => "Calling",
        CallLogStatuses.Answered => "Accepted",
        CallLogStatuses.Ended => "Completed",
        _ => status
    };

    private static string GetInitials(string value)
    {
        var words = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length switch
        {
            0 => "?",
            1 => words[0][..1].ToUpperInvariant(),
            _ => string.Concat(words[0][..1], words[^1][..1]).ToUpperInvariant()
        };
    }

    private static string FormatDuration(TimeSpan duration) => duration.TotalHours >= 1
        ? duration.ToString(@"h\h\ mm\m")
        : duration.ToString(@"m\m\ ss\s");

    private static string GetTimeLabel(DateTime createdAtUtc)
    {
        var createdAt = createdAtUtc.ToLocalTime();
        var today = DateTime.Now.Date;
        return createdAt.Date == today
            ? createdAt.ToString("h:mm tt")
            : createdAt.Date == today.AddDays(-1)
                ? "Yesterday"
                : createdAt.ToString("MMM d");
    }
}