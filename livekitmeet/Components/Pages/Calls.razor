@page "/calls"
@attribute [Authorize]
@layout MainLayout
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICallLogService CallLogs
@inject NavigationManager Navigation

<PageTitle>wincall - Call history</PageTitle>

<div class="wc-page wc-calls-page">
    <header class="wc-page-heading">
        <div>
            <span class="wc-kicker">Your activity</span>
            <h1>Call history</h1>
            <p>Every room, participant session, and invitation outcome in one place.</p>
        </div>
        <a class="wc-primary-button" href="/contacts">Start a call <span aria-hidden="true">+</span></a>
    </header>

    <div class="wc-search-bar">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
        <input class="wc-input" @bind="searchTerm" @bind:event="oninput" placeholder="Search call history..." autocomplete="off" />
    </div>

    @if (rooms is null)
    {
        <div class="wc-empty-state">Loading call history...</div>
    }
    else if (!filteredRooms.Any())
    {
        <div class="wc-empty-state">
            <span class="wc-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 4h3l2 5-2.3 1.4a12.7 12.7 0 0 0 4.9 4.9L15 13l5 2v3a1 1 0 0 1-1 1C10.7 19 5 13.3 5 6a2 2 0 0 1 1-2Z" /></svg></span>
            <strong>No matching rooms</strong>
            <span>Start a call from your contacts to build your history.</span>
        </div>
    }
    else
    {
        <section class="wc-history-list" aria-label="Call history">
            @foreach (var room in filteredRooms)
            {
                <div class="wc-history-row wc-room-history-row">
                    <div class="wc-call-person">
                        <span class="wc-contact-avatar">RM</span>
                        <span class="wc-call-person-copy">
                            <strong>@room.RoomName</strong>
                            <small>@GetParticipantNames(room)</small>
                        </span>
                    </div>
                    <div class="wc-history-room">
                        <span>@room.ParticipantCount people</span>
                        <small>@GetTimeLabel(room.CreatedAtUtc)</small>
                    </div>
                    <div class="wc-history-result @GetRoomStatusClass(room)">
                        <span>@GetRoomDetail(room)</span>
                        <small>@GetRoomStatus(room)</small>
                    </div>
                    <button type="button" class="wc-row-call" @onclick="() => OpenRoom(room.RoomName)" aria-label="Open @room.RoomName" title="Open @room.RoomName">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </button>
                </div>
            }
        </section>
    }
</div>

@code {
    private IReadOnlyList<CallRoomHistoryItem>? rooms;
    private string searchTerm = string.Empty;

    private IEnumerable<CallRoomHistoryItem> filteredRooms => (rooms ?? Array.Empty<CallRoomHistoryItem>())
        .Where(room => string.IsNullOrWhiteSpace(searchTerm) ||
                      room.RoomName.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase) ||
                      room.Participants.Any(participant =>
                          participant.DisplayName.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase) ||
                          participant.UserName.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                      room.Invitations.Any(invitation =>
                          invitation.CallerDisplayName.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase) ||
                          invitation.RecipientDisplayName.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        rooms = await CallLogs.GetRecentRoomLogsAsync(authState.User, 100);
    }

    private void OpenRoom(string roomName)
    {
        Navigation.NavigateTo($"/rooms/{Uri.EscapeDataString(roomName)}?audio=true&video=true");
    }

    private static string GetRoomStatus(CallRoomHistoryItem room) => room.Status;

    private static string GetRoomStatusClass(CallRoomHistoryItem room) =>
        GetRoomStatus(room).ToLowerInvariant().Replace(' ', '-');

    private static string GetRoomDetail(CallRoomHistoryItem room)
    {
        if (room.DurationSeconds is int durationSeconds)
        {
            return FormatDuration(TimeSpan.FromSeconds(durationSeconds));
        }

        return room.Status;
    }

    private static string GetParticipantNames(CallRoomHistoryItem room)
    {
        var names = room.Participants
            .Select(participant => participant.DisplayName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        return names.Length == 0 ? "No one joined" : string.Join(", ", names);
    }

    private static string GetInvitationStatusLabel(string status) => status switch
    {
        CallLogStatuses.Declined => "Declined",
        CallLogStatuses.Cancelled => "Cancelled",
        CallLogStatuses.Failed => "Not connected",
        CallLogStatuses.Ringing => "Calling",
        CallLogStatuses.Answered or CallLogStatuses.Ended => "Completed",
        _ => status
    };

    private static string FormatDuration(TimeSpan duration) => duration.TotalHours >= 1
        ? duration.ToString(@"h\h\ mm\m")
        : duration.ToString(@"m\m\ ss\s");

    private static string GetTimeLabel(DateTime createdAtUtc)
    {
        var createdAt = createdAtUtc.ToLocalTime();
        var today = DateTime.Now.Date;
        return createdAt.Date == today
            ? createdAt.ToString("h:mm tt")
            : createdAt.Date == today.AddDays(-1)
                ? "Yesterday"
                : createdAt.ToString("MMM d");
    }
}