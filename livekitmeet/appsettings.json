{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Directory": "logs",
      "FileName": "livekitmeet",
      "RetainedDays": 14,
      "EnableNormalLogs": false
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "mssql",
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=WinCall;Integrated Security=True;TrustServerCertificate=True;"
  },
  "Auth": {
    "JwtSecret": "development-only-change-this-secret-to-a-long-random-value-1234567890",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Firebase": {
    "ProjectId": "",
    "ClientEmail": "",
    "PrivateKey": ""
  },
  "Admin": {
    "UserName": "admin",
    "DisplayName": "Administrator",
    "Password": "12345678"
  },
  "LiveKit": {
    "ApiKey": "devkey",
    "ApiSecret": "secret",
    "Url": "wss://192.168.1.6:8443/livekit"
  }
}
